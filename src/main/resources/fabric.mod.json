{
  "schemaVersion": 1,
  "id": "nova",
  "version": "1.3.4-MC1.21.11",
  "name": "Nova Client",
  "description": "A Fabric utility client for Minecraft 1.21.11. Combines features from Wurst, Meteor, Meteor Rejects and LiquidBounce.",
  "authors": [
    "Nova Client contributors"
  ],
  "contact": {},
  "license": "GPL-3.0-or-later",
  "icon": "assets/nova/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.novaclient.NovaClient"
    ]
  },
  "mixins": [
    "nova.mixins.json",
    "nova.sodium.mixins.json"
  ],
  "accessWidener": "nova.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.1",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "recommends": {
    "sodium": "*"
  }
}
